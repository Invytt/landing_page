# ---------------------------------------------------------------------------
# Environment variables — reference. This is the ONLY file with comments;
# the real env files hold values only.
#
# Three real files, all gitignored, all created by copying this one. Every one
# of them carries the SAME keys in the SAME order as this file, so they diff
# cleanly — only the values change. Never add a key to one without adding it
# to the others:
#
#   .env.development.local   Loaded by `next dev`.
#   .env.production.local    Loaded by `next build` / `next start` locally.
#                            Next.js picks the file by NODE_ENV, so dev values
#                            can never leak into a production build.
#   .env                     Loaded explicitly by scripts/send-sample-emails.mjs
#                            (`config({ path: ".env", override: true })`) and by
#                            the Prisma CLI, which does NOT read *.local files.
#                            Mirror the dev values here.
#
# A fourth consumer is not a file: the Supabase edge functions read their env
# from Supabase project secrets. Push them with
# `supabase secrets set --env-file .env.production.local` or set them in the
# dashboard (Edge Functions → Secrets).
#
# No .local file is uploaded to Vercel — production values there live in
# Settings → Environment Variables (or `vercel env add <NAME> production`).
# Keep them in sync by hand, or run
# `vercel env pull .env.production.local --environment=production` to
# overwrite the local copy from Vercel.
#
# Vercel needs section 1 only. Nothing else in this file is used to build or
# serve the site — the database and the mail worker both live inside Supabase,
# not inside the Next.js app. The other sections are carried in the files so
# local Prisma and script runs work from a single source.
#
# Keys WITHOUT the NEXT_PUBLIC_ prefix are server-only and never reach the
# browser. Keys WITH it are inlined into the client bundle at build time —
# treat them as public.
#
# The "DEV vs PROD" note on each key says whether the value should differ.
# ---------------------------------------------------------------------------


# ===========================================================================
# 1. Next.js app  →  .env.development.local / .env.production.local + Vercel
# ===========================================================================

# URL of the deployed Supabase `subscribe` edge function. Read at
# components/TicketCTA.tsx and POSTed to by lib/waitlist.ts `subscribe()`.
# Public — inlined into the client bundle, so it is visible to anyone.
# Unset means the fetch targets "undefined" and every signup shows the generic
# network error; there is no fallback.
# DEV vs PROD: same today — one Supabase project serves both. Point dev at a
# second project (or `supabase start`) when writing live signups stops being
# okay. Note the value already differs per environment on Vercel today.
NEXT_PUBLIC_SUBSCRIBE_URL=https://<project-ref>.supabase.co/functions/v1/subscribe


# ===========================================================================
# 2. Prisma  →  .env  (local only; never needed on Vercel)
# ===========================================================================
# prisma/schema.prisma reads both. Nothing in app/ or components/ imports
# @prisma/client — the schema exists to model/introspect the Supabase table
# that the edge functions write to. Only set these when running Prisma
# locally; the deployed site never opens a database connection.
# The Prisma CLI reads `.env` and ignores *.local, so the copies in
# .env.development.local / .env.production.local are for Next.js server code
# only — put the working values in `.env`.
# DEV vs PROD: same — one Supabase project serves both, so `prisma migrate dev`
# and local seeding write to live data. Point dev at a second Supabase project
# (or a local `supabase start`) when that stops being okay.

# Pooled connection (PgBouncer, transaction mode, IPv4-only) — app runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Non-pooled/session-mode connection — Prisma migrations only.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"


# ===========================================================================
# 3. Supabase edge functions  →  Supabase project secrets (NOT a local file)
# ===========================================================================
# Consumed by supabase/functions/subscribe and
# supabase/functions/send-waitlist-emails via Deno.env.get(). Only put these
# in a local file when running `supabase functions serve`.

# Injected automatically by the Supabase platform on deployed functions — you
# only set them by hand for local serving. Dashboard → Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
# service_role (or sb_secret_...) key — bypasses RLS, full DB access.
# Server-only. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Shared secret the pg_cron job sends as the `x-cron-secret` header to
# send-waitlist-emails; mismatched or missing → 401. That function runs with
# verify_jwt = false (deploy it with --no-verify-jwt), so THIS is the only
# thing standing between the public internet and the mail queue.
# If unset the check is skipped entirely and the endpoint is wide open — set it.
# DEV vs PROD: SHOULD DIFFER. Any long random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=<random-32-byte-hex>

# AutoSend credentials for the waitlist welcome email (bulk send, 100/batch).
# DEV vs PROD: same account — there is no sandbox mode, local sends go to real
# inboxes. Guard test runs by recipient.
AUTOSEND_API_KEY=AS_<...>
# Only required for org-admin (ASA_) keys; sent as the x-project-id header.
AUTOSEND_PROJECT_ID=<project-id>
# Stored AutoSend template for the "You're on the Invytt waitlist!" email.
# Unset → the worker cannot send and the batch is released for retry.
AUTOSEND_TEMPLATE_ID=A-<...>


# ===========================================================================
# 4. One-off email preview script  →  .env
# ===========================================================================
# scripts/send-sample-emails.mjs renders emails/*.html with sample data and
# sends via AutoSend's raw-HTML endpoint. It loads `.env` (not .env.local) and
# hard-codes its recipient. Reuses the same AutoSend key/project as section 3.
#
# AUTOSEND_API_KEY=AS_<...>       (same value as above)
# AUTOSEND_PROJECT_ID=<project-id> (same value as above)

# Verified sender address on the AutoSend domain.
# Defaults to events@invytt.com if unset.
EMAIL_FROM=events@invytt.com
